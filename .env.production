# SIPMT customer production template for Docker deployment.
# Copy this file to .env before running the release bundle.

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
POSTGRES_DB=sipmt
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-customer-password

# Leave empty to use bundled PostgreSQL from docker-compose.
SIPMT_DATABASE_URL=

# -----------------------------------------------------------------------------
# Runtime paths inside the container bundle
# -----------------------------------------------------------------------------
DATABASE_URL=
DATABASE_PATH=./data/sipmt.db
SQLITE_MIRROR_PATH=./data/sipmt.db
UPLOAD_FOLDER=./uploads
EXPORT_FOLDER=./exports
TEMP_FOLDER=./temp
LOG_FILE=./logs/sipmt.log

# -----------------------------------------------------------------------------
# App behavior
# -----------------------------------------------------------------------------
DEBUG=False
SECRET_KEY=change-this-random-secret-key
MAX_FILE_SIZE=10485760
STORE_FILES_IN_DB=false

# -----------------------------------------------------------------------------
# OCR / NLP
# -----------------------------------------------------------------------------
ENABLE_OCR=False
OCR_LANGUAGE=eng
SPACY_MODEL=en_core_web_sm

# -----------------------------------------------------------------------------
# Matching
# -----------------------------------------------------------------------------
FUZZY_MATCH_THRESHOLD=0.7
CONFIDENCE_THRESHOLD=0.6

# -----------------------------------------------------------------------------
# Customer-side internet-enabled features
# -----------------------------------------------------------------------------
ENABLE_GEOCODING=True

# -----------------------------------------------------------------------------
# Semantic analysis
# -----------------------------------------------------------------------------
ENABLE_SEMANTIC_ANALYSIS=True
SEMANTIC_LLM_PROVIDER=ollama
REFERENCE_TEMPLATES_DIR=./reference_templates

# Bundled Ollama service is used automatically by docker-compose.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b-instruct
OLLAMA_TIMEOUT_SEC=600
OLLAMA_KEEP_ALIVE=60m
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_GPU=-1
OLLAMA_NUM_BATCH=512

# Optional Gemini fallback for customer sites that also want cloud-based analysis.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-lite
GEMINI_FALLBACK_MODELS=gemini-2.0-flash-lite-001,gemini-2.0-flash,gemini-2.5-flash

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO