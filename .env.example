# Database Configuration
# Leave DATABASE_URL empty for local SQLite development and for Streamlit Community Cloud demos
# unless you are using a managed external PostgreSQL instance.
DATABASE_URL=
DATABASE_PATH=./data/sipmt.db
# Example local PostgreSQL URL for a self-managed install:
# DATABASE_URL=postgresql://postgres:replace-with-password@127.0.0.1:5432/incluscape?sslmode=disable

# File Paths
UPLOAD_FOLDER=./uploads
EXPORT_FOLDER=./exports
TEMP_FOLDER=./temp
MAX_FILE_SIZE=10485760

# OCR (requires Tesseract installed: https://github.com/tesseract-ocr/tesseract)
ENABLE_OCR=False
OCR_LANGUAGE=eng

# NLP — download model with: python -m spacy download en_core_web_sm
SPACY_MODEL=en_core_web_sm

# Application
DEBUG=False
SECRET_KEY=replace-with-a-strong-random-secret-key

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/sipmt.log

# Matching thresholds (0.0–1.0)
FUZZY_MATCH_THRESHOLD=0.7
CONFIDENCE_THRESHOLD=0.6

# Geospatial (optional)
ENABLE_GEOCODING=False

# Semantic Analysis
# Local development with Ollama: set SEMANTIC_LLM_PROVIDER=ollama
# Streamlit Community Cloud demo: set SEMANTIC_LLM_PROVIDER=gemini and configure GEMINI_API_KEY in Secrets.
SEMANTIC_LLM_PROVIDER=ollama
# Gemini cloud settings
GEMINI_API_KEY=
# Use a lighter model for day-to-day testing and Streamlit Cloud demos to reduce quota pressure.
GEMINI_MODEL=gemini-2.0-flash-lite
# Optional comma-separated fallback chain used when quota/rate/model errors occur.
GEMINI_FALLBACK_MODELS=gemini-2.0-flash-lite-001,gemini-2.0-flash,gemini-2.5-flash
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b-instruct
OLLAMA_TIMEOUT_SEC=600
OLLAMA_KEEP_ALIVE=60m
OLLAMA_NUM_CTX=4096
# Apple M1/M2 Metal GPU acceleration (set OLLAMA_NUM_GPU=-1 to use all GPU layers):
OLLAMA_NUM_GPU=-1
OLLAMA_NUM_BATCH=512
# OLLAMA_NUM_THREAD=6
ENABLE_SEMANTIC_ANALYSIS=True
REFERENCE_TEMPLATES_DIR=./reference_templates

# Streamlit Community Cloud Secrets example:
# ENABLE_SEMANTIC_ANALYSIS=true
# SEMANTIC_LLM_PROVIDER=gemini
# GEMINI_API_KEY=your-real-google-api-key
# GEMINI_MODEL=gemini-2.0-flash
# DATABASE_URL=
# DATABASE_PATH=./data/sipmt.db
