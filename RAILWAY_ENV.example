# Railway Deployment Environment Variables

## Ollama Configuration (optional: use only if connecting to a remote Ollama service)
# OLLAMA_BASE_URL=https://your-remote-ollama-endpoint
# OLLAMA_MODEL=qwen2.5:1.5b
# OLLAMA_TIMEOUT_SEC=600
# OLLAMA_KEEP_ALIVE=60m
# OLLAMA_NUM_CTX=4096
# OLLAMA_NUM_GPU=-1
# OLLAMA_NUM_BATCH=512

## Semantic Analysis
# Set to `ollama` only when OLLAMA_BASE_URL points to an external Ollama service.
# For Railway free-tier deployment without external Ollama, set provider to gemini.
SEMANTIC_LLM_PROVIDER=gemini
ENABLE_SEMANTIC_ANALYSIS=true

## File Paths (relative to container)
DATABASE_PATH=./data/incluscape.db
UPLOAD_FOLDER=./uploads
EXPORT_FOLDER=./exports
TEMP_FOLDER=./temp

## Application Settings
DEBUG=false
LOG_LEVEL=INFO
SECRET_KEY=your-secret-key-here-change-in-railway-dashboard

## Geospatial (Optional)
ENABLE_GEOCODING=false

## Google Gemini (Optional fallback - uncomment if needed)
GEMINI_API_KEY=your-api-key
GEMINI_MODEL=gemini-2.0-flash-lite

## Streamlit Configuration (managed automatically)
# STREAMLIT_SERVER_PORT=8501
# STREAMLIT_SERVER_ADDRESS=0.0.0.0
# STREAMLIT_SERVER_HEADLESS=true
